{
  "$schema": "https://www.designtokens.org/schemas/2024.10/format.json",
  "name": "Forge — Profile Card",
  "color": {
    "page-bg": {
      "$type": "color",
      "$value": "#F8FAFC",
      "$extensions": {
        "qoder.forge": {
          "role": "page-bg",
          "layers": [
            "Page"
          ],
          "mode": {
            "light": "#F8FAFC"
          }
        }
      }
    },
    "bg-default": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$extensions": {
        "qoder.forge": {
          "role": "bg-default",
          "layers": [
            "Profile Card",
            "Btn"
          ],
          "mode": {
            "light": "#FFFFFF"
          }
        }
      }
    },
    "border-subtle": {
      "$type": "color",
      "$value": "#E2E8F0",
      "$extensions": {
        "qoder.forge": {
          "role": "border-subtle",
          "layers": [
            "Profile Card",
            "Divider"
          ],
          "mode": {
            "light": "#E2E8F0"
          }
        }
      }
    },
    "accent-brand": {
      "$type": "color",
      "$value": "#3730A3",
      "$extensions": {
        "qoder.forge": {
          "role": "accent-brand",
          "layers": [
            "Avatar"
          ],
          "mode": {
            "light": "#3730A3"
          }
        }
      }
    },
    "accent-brand-2": {
      "$type": "color",
      "$value": "#0F172A",
      "$extensions": {
        "qoder.forge": {
          "role": "accent-brand-2",
          "layers": [
            "Name",
            "Value"
          ],
          "mode": {
            "light": "#0F172A"
          }
        }
      }
    },
    "text-muted": {
      "$type": "color",
      "$value": "#475569",
      "$extensions": {
        "qoder.forge": {
          "role": "text-muted",
          "layers": [
            "Role",
            "Desc",
            "Label"
          ],
          "mode": {
            "light": "#475569"
          }
        }
      }
    },
    "trend-positive": {
      "$type": "color",
      "$value": "#047857",
      "$extensions": {
        "qoder.forge": {
          "role": "trend-positive",
          "layers": [
            "Badge"
          ],
          "mode": {
            "light": "#047857"
          }
        }
      }
    }
  },
  "size": {
    "spacing": {
      "1": {
        "$type": "dimension",
        "$value": "4px"
      },
      "2": {
        "$type": "dimension",
        "$value": "8px"
      },
      "3": {
        "$type": "dimension",
        "$value": "16px"
      },
      "4": {
        "$type": "dimension",
        "$value": "24px"
      }
    },
    "radius": {
      "md": {
        "$type": "dimension",
        "$value": "8px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "16px"
      },
      "full": {
        "$type": "dimension",
        "$value": "50px"
      }
    }
  },
  "type": {
    "text/base-bold": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": "16px",
        "fontWeight": 700,
        "letterSpacing": "0px",
        "lineHeight": "normal"
      },
      "$extensions": {
        "qoder.forge": {
          "layers": [
            "Avatar"
          ]
        }
      }
    },
    "text/lg-bold": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": "18px",
        "fontWeight": 700,
        "letterSpacing": "0px",
        "lineHeight": "normal"
      },
      "$extensions": {
        "qoder.forge": {
          "layers": [
            "Name"
          ]
        }
      }
    },
    "text/sm-regular": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": "14px",
        "fontWeight": 400,
        "letterSpacing": "0px",
        "lineHeight": "normal"
      },
      "$extensions": {
        "qoder.forge": {
          "layers": [
            "Role",
            "Desc"
          ]
        }
      }
    },
    "text/xs-semibold": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": "12px",
        "fontWeight": 600,
        "letterSpacing": "0px",
        "lineHeight": "normal"
      },
      "$extensions": {
        "qoder.forge": {
          "layers": [
            "Badge"
          ]
        }
      }
    },
    "text/xl-bold": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": "20px",
        "fontWeight": 700,
        "letterSpacing": "0px",
        "lineHeight": "normal"
      },
      "$extensions": {
        "qoder.forge": {
          "layers": [
            "Value"
          ]
        }
      }
    },
    "text/xs-regular": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": "12px",
        "fontWeight": 400,
        "letterSpacing": "0px",
        "lineHeight": "normal"
      },
      "$extensions": {
        "qoder.forge": {
          "layers": [
            "Label"
          ]
        }
      }
    },
    "text/base-semibold": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Arial",
        "fontSize": "15px",
        "fontWeight": 600,
        "letterSpacing": "0px",
        "lineHeight": "normal"
      },
      "$extensions": {
        "qoder.forge": {
          "layers": [
            "Btn"
          ]
        }
      }
    }
  },
  "component": {
    "Profile Card": {
      "$type": "component",
      "$value": {
        "variants": null,
        "properties": {
          "text": [
            {
              "name": "Avatar",
              "layer": "Avatar",
              "value": "FF",
              "style": "text/base-bold",
              "font": "Inter",
              "truncate": false
            },
            {
              "name": "Name",
              "layer": "Name",
              "value": "Farhad Fesahat",
              "style": "text/lg-bold",
              "font": "Inter",
              "truncate": false
            },
            {
              "name": "Role",
              "layer": "Role",
              "value": "Senior Design Engineer",
              "style": "text/sm-regular",
              "font": "Inter",
              "truncate": false
            },
            {
              "name": "Badge",
              "layer": "Badge",
              "value": "Pro Member",
              "style": "text/xs-semibold",
              "font": "Inter",
              "truncate": false
            },
            {
              "name": "Desc",
              "layer": "Desc",
              "value": "Building scalable SaaS products and bridging the gap between design and code.",
              "style": "text/sm-regular",
              "font": "Inter",
              "truncate": false
            },
            {
              "name": "Value",
              "layer": "Value",
              "value": "24",
              "style": "text/xl-bold",
              "font": "Inter",
              "truncate": false
            },
            {
              "name": "Label",
              "layer": "Label",
              "value": "Projects",
              "style": "text/xs-regular",
              "font": "Inter",
              "truncate": false
            },
            {
              "name": "Value",
              "layer": "Value",
              "value": "8.5k",
              "style": "text/xl-bold",
              "font": "Inter",
              "truncate": false
            },
            {
              "name": "Label",
              "layer": "Label",
              "value": "Followers",
              "style": "text/xs-regular",
              "font": "Inter",
              "truncate": false
            },
            {
              "name": "Btn",
              "layer": "Btn",
              "value": "Follow Profile",
              "style": "text/base-semibold",
              "font": "Arial",
              "truncate": false
            }
          ],
          "boolean": [],
          "swap": []
        },
        "instances": 1,
        "states": [
          ":hover",
          ":focus-visible"
        ]
      },
      "$extensions": {
        "qoder.forge": {
          "modes": {
            "collection": "Forge — Profile Card",
            "modes": [
              "Light"
            ]
          },
          "offGrid": [
            2
          ],
          "edges": {
            "truncate": 0,
            "mediaShrink": false,
            "layers": 19,
            "autoLayout": 9,
            "grids": 1
          }
        }
      }
    }
  }
}